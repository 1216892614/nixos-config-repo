#!/usr/bin/env bash
# clippaste: decode cliphist entry from stdin, then paste intelligently
# - text: use wtype to type directly (no shortcut simulation needed)
# - image: wl-copy then simulate paste shortcut (Ctrl+Shift+V for terminals, Ctrl+V otherwise)

set -euo pipefail

# Decode the selected cliphist entry into clipboard
cliphist decode | wl-copy

# Wait for walker to close and focus to return
sleep 0.4

# Determine MIME type of current clipboard content
mime=$(wl-paste --list-types 2>/dev/null | head -1)

if [[ "$mime" == image/* ]]; then
  # Image: must simulate paste shortcut
  app_id=$(niri msg -j focused-window 2>/dev/null | jq -r '.app_id // ""')

  # List of terminal app_ids that use Ctrl+Shift+V
  terminals="kitty|foot|Alacritty|wezterm|org.wezfurlong.wezterm|com.mitchellh.ghostty"

  if [[ "$app_id" =~ ^($terminals)$ ]]; then
    wtype -M ctrl -M shift v -m shift -m ctrl
  else
    wtype -M ctrl v -m ctrl
  fi
else
  # Text: type directly via virtual keyboard (works everywhere, no shortcut needed)
  wl-paste --no-newline | wtype -s 50 -
fi
