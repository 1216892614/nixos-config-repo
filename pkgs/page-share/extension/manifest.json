{
  "manifest_version": 3,
  "name": "Page Share",
  "description": "告诉 AI Agent 你想让它操作的页面",
  "version": "2.0.4",
  "permissions": ["activeTab", "tabs", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
