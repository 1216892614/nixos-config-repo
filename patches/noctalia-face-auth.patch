+void LockScreen::startFaceAuth() {
+  if (m_faceAuthRunning || !m_locked || m_unlocking) {
+    return;
+  }
+  m_faceAuthRunning = true;
+  const std::uint64_t generation = ++m_faceAuthGeneration;
+  const PamAuthenticator authenticator = m_authenticator;
+  const std::string language(i18n::Service::instance().language());
+  const std::weak_ptr<void> guard = m_aliveGuard;
+  std::thread([this, guard, generation, authenticator, language] {
+    const auto result = authenticator.authenticateCurrentUser("", "noctalia-face", language, "");
+    DeferredCall::callLater([this, guard, generation, success = result.success] {
+      if (guard.expired()) {
+        return;
+      }
+      handleFaceAuthResult(generation, success);
+    });
+  }).detach();
+}
+
+void LockScreen::handleFaceAuthResult(std::uint64_t generation, bool success) {
+  // 无论结果是否过期都清除运行标记：helper 进程已退出，摄像头已释放
+  m_faceAuthRunning = false;
+  if (generation != m_faceAuthGeneration || !m_locked || m_unlocking) {
+    return;
+  }
+  if (!success) {
+    kLog.debug("face authentication failed; retrying on next user activity");
+    return;
+  }
+  kLog.info("face authentication succeeded");
+  clearSensitiveString(m_password);
+  m_status = i18n::tr("lockscreen.unlocked");
+  m_statusIsError = false;
+  updatePromptOnSurfaces();
+  unlock();
+}
