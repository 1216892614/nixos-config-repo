+// script 会包裹真实 shell；目录应从它的子进程读取，保留终端录制功能。
+fn shell_pid_inside_recorder(pid: u32) -> u32 {
+    #[cfg(target_os = "linux")]
+    {
+        if std::fs::read_to_string(format!("/proc/{pid}/comm"))
+            .map(|name| name.trim() == "script")
+            .unwrap_or(false)
+        {
+            if let Ok(children) = std::fs::read_to_string(format!("/proc/{pid}/task/{pid}/children")) {
+                if let Some(child) = children.split_whitespace().next().and_then(|s| s.parse().ok()) {
+                    return child;
+                }
+            }
+        }
+    }
+    pid
+}
