{
  # 用户名
  username = "ep-o1";

  # Git 配置
  gitUserName = "HuNerd";
  gitUserEmail = "hndppt@outlook.com";

  # 主机名
  hostname = "desktop";

  # mihomo (clash-meta) 订阅地址
  mihomoSubscribeUrl = "https://example.com/subscribe?token=TODO";
  mihomoConfigFile = "/etc/mihomo/config.yaml";

  # SSH 公钥（用于 openssh authorizedKeys）
  sshPublicKey = "ssh-ed25519 AAAA... TODO";

  # 代理端口
  mihomoMixedPort = 7890;
  mihomoApiPort = 9090;

  # 4K 缩放比例
  displayScale = 2.0;

  # Context7 API Key (for MCP)
  context7ApiKey = "ctx7sk-REPLACE_ME";

  # OpenClaw gateway token (paste from dashboard http://localhost:18789 → Control UI); set so clients (e.g. Cursor) auto-auth
  # openclawGatewayToken = "YOUR_TOKEN_FROM_DASHBOARD";

  # OpenClaw Discord bot token (from Discord Developer Portal; enable Message Content Intent)
  # discordBotToken = "YOUR_DISCORD_BOT_TOKEN";
  # OpenClaw Discord: pre-approved DM user IDs (allowlist; set to [] to use pairing only)
  # openclawDiscordAllowFrom = [ "YOUR_DISCORD_USER_ID" ];

  # Anthropic (Claude Code): set via fish env ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN (HM)
  # anthropicBaseUrl = "https://..."; anthropicAuthToken = "sk-...";
  # Per-CLI: Gemini config file generated when key is set
  # geminiBaseUrl = "https://...";    geminiApiKey = "sk-...";
  # OpenClaw: OpenRouter provider (single API key, model IDs from openrouter.ai)
  # openrouterApiKey = "sk-or-v1-...";
  # openclawOpenRouterModels = [ "moonshotai/kimi-k2.5" "anthropic/claude-opus-4.6" ... ];
  # openclawDefaultModel = "moonshotai/kimi-k2.5";  # default agent model (must be in openclawOpenRouterModels)
}
