{
  # 用户名
  username = "ep-o1";

  # Git 配置
  gitUserName = "HuNerd";
  gitUserEmail = "hndppt@outlook.com";

  # 主机名
  hostname = "desktop";

  # mihomo (clash-meta) 订阅地址
  mihomoSubscribeUrl = "https://example.com/subscribe?token=TODO";
  mihomoConfigFile = "/etc/mihomo/config.yaml";

  # SSH 公钥（用于 openssh authorizedKeys）
  sshPublicKey = "ssh-ed25519 AAAA... TODO";

  # 代理端口
  mihomoMixedPort = 7890;
  mihomoApiPort = 9090;

  # 4K 缩放比例
  displayScale = 2.0;

  # AI keys / URLs (Claude Code, Codex, Gemini CLI, OpenCode): 按自己的使用方式手动配置
  # AstrBot: 运行 astrbot init 后按 https://astrbot.app/ 配置

  # Cloudflare Zero Trust (WARP-to-WARP private network)
  cloudflareTunnelToken = ""; # Leave empty to disable tunnel; get from: cloudflared tunnel create <name>
  cloudflareTeamName = ""; # Your Zero Trust team name (e.g., "myteam" from myteam.cloudflareaccess.com)

  # Service ports for Zero Trust access
  rustdeskPort = 21116;
  rustdeskRelayPort = 21117;
  rustdeskHbbsPort = 21115;
  rustdeskHbbrPort = 21116;
  rustdeskPermanentPassword = ""; # Optional: set a permanent unattended-access password
  fileBrowserPort = 8080;
  openCodePort = 3000;
  piAgentPort = 3001;            # Pi Agent (containerized opencode serve)
}
