{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Noctalia",
  "author": "noctalia-template",
  "themes": [
    {
      "name": "Noctalia",
      "appearance": "dark",
      "style": {
        "background": "{{colors.surface.default.hex}}",
        "editor.background": "{{colors.surface.default.hex}}",
        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editor.gutter.background": "{{colors.surface.default.hex}}",
        "editor.active_line.background": "{{colors.surface_variant.default.hex}}20",
        "editor.highlighted_line.background": "{{colors.surface_variant.default.hex}}30",
        "editor.wrap_guide": "{{colors.surface_variant.default.hex}}40",
        "editor.invisible": "{{colors.surface_variant.default.hex}}",
        "tab_bar.background": "{{colors.surface.default.hex}}",
        "tab.active_background": "{{colors.surface_container.default.hex}}",
        "tab.inactive_background": "{{colors.surface.default.hex}}",
        "toolbar.background": "{{colors.surface.default.hex}}",
        "title_bar.background": "{{colors.surface.default.hex}}",
        "panel.background": "{{colors.surface.default.hex}}",
        "status_bar.background": "{{colors.surface.default.hex}}",
        "scrollbar.thumb.background": "{{colors.surface_variant.default.hex}}60",
        "scrollbar.track.background": "{{colors.surface.default.hex}}",
        "border": "{{colors.surface_variant.default.hex}}",
        "border.variant": "{{colors.surface_variant.default.hex}}80",
        "border.focused": "{{colors.primary.default.hex}}",
        "element.hover": "{{colors.surface_variant.default.hex}}40",
        "element.active": "{{colors.surface_variant.default.hex}}60",
        "element.selected": "{{colors.primary.default.hex}}30",
        "ghost_element.hover": "{{colors.surface_variant.default.hex}}30",
        "ghost_element.active": "{{colors.surface_variant.default.hex}}50",
        "ghost_element.selected": "{{colors.primary.default.hex}}20",
        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "text.placeholder": "{{colors.on_surface_variant.default.hex}}80",
        "text.disabled": "{{colors.on_surface_variant.default.hex}}60",
        "text.accent": "{{colors.primary.default.hex}}",
        "icon": "{{colors.on_surface.default.hex}}",
        "icon.muted": "{{colors.on_surface_variant.default.hex}}",
        "icon.accent": "{{colors.primary.default.hex}}",
        "link_text.hover": "{{colors.primary.default.hex}}",
        "terminal.background": "{{colors.terminal_background.default.hex}}",
        "terminal.foreground": "{{colors.terminal_foreground.default.hex}}",
        "terminal.ansi.black": "{{colors.terminal_normal_black.default.hex}}",
        "terminal.ansi.red": "{{colors.terminal_normal_red.default.hex}}",
        "terminal.ansi.green": "{{colors.terminal_normal_green.default.hex}}",
        "terminal.ansi.yellow": "{{colors.terminal_normal_yellow.default.hex}}",
        "terminal.ansi.blue": "{{colors.terminal_normal_blue.default.hex}}",
        "terminal.ansi.magenta": "{{colors.terminal_normal_magenta.default.hex}}",
        "terminal.ansi.cyan": "{{colors.terminal_normal_cyan.default.hex}}",
        "terminal.ansi.white": "{{colors.terminal_normal_white.default.hex}}",
        "terminal.ansi.bright_black": "{{colors.terminal_bright_black.default.hex}}",
        "terminal.ansi.bright_red": "{{colors.terminal_bright_red.default.hex}}",
        "terminal.ansi.bright_green": "{{colors.terminal_bright_green.default.hex}}",
        "terminal.ansi.bright_yellow": "{{colors.terminal_bright_yellow.default.hex}}",
        "terminal.ansi.bright_blue": "{{colors.terminal_bright_blue.default.hex}}",
        "terminal.ansi.bright_magenta": "{{colors.terminal_bright_magenta.default.hex}}",
        "terminal.ansi.bright_cyan": "{{colors.terminal_bright_cyan.default.hex}}",
        "terminal.ansi.bright_white": "{{colors.terminal_bright_white.default.hex}}",
        "created": "{{colors.terminal_normal_green.default.hex}}",
        "modified": "{{colors.terminal_normal_blue.default.hex}}",
        "deleted": "{{colors.terminal_normal_red.default.hex}}",
        "error": "{{colors.error.default.hex}}",
        "warning": "{{colors.terminal_normal_yellow.default.hex}}",
        "info": "{{colors.primary.default.hex}}",
        "hint": "{{colors.on_surface_variant.default.hex}}",
        "predictive": "{{colors.on_surface_variant.default.hex}}80",
        "syntax": {
          "comment": { "color": "{{colors.on_surface_variant.default.hex}}80" },
          "string": { "color": "{{colors.terminal_normal_green.default.hex}}" },
          "keyword": { "color": "{{colors.terminal_normal_magenta.default.hex}}" },
          "function": { "color": "{{colors.terminal_normal_blue.default.hex}}" },
          "number": { "color": "{{colors.terminal_normal_yellow.default.hex}}" },
          "type": { "color": "{{colors.terminal_normal_cyan.default.hex}}" },
          "variable": { "color": "{{colors.on_surface.default.hex}}" },
          "constant": { "color": "{{colors.terminal_normal_red.default.hex}}" },
          "operator": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "tag": { "color": "{{colors.terminal_normal_cyan.default.hex}}" },
          "attribute": { "color": "{{colors.terminal_normal_yellow.default.hex}}" }
        }
      }
    }
  ]
}
